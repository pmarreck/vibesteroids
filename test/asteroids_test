#!/usr/bin/env node

// Simple Node.js test runner for Asteroids game
// This extracts and runs the JavaScript code from the HTML file

const fs = require('fs');
const path = require('path');
const { JSDOM } = require('jsdom');

// Set up jsdom environment with all required DOM elements and test URL
const dom = new JSDOM(`<!DOCTYPE html><html><body>
    <canvas id="gameCanvas"></canvas>
    <div id="gameOverScreen"></div>
    <div id="finalScore"></div>
    <div id="debugToggleArea"></div>
    <div id="testModeToggleArea"></div>
    <div id="mobileTutorial"></div>
    <div id="debugInfo"></div>
</body></html>`, {
    url: 'http://localhost?test',  // Add test parameter to trigger test mode
    pretendToBeVisual: true,
    resources: 'usable'
});

// Set up global objects for browser compatibility
global.window = dom.window;
global.document = dom.window.document;
global.navigator = dom.window.navigator;
global.HTMLCanvasElement = dom.window.HTMLCanvasElement;
global.CanvasRenderingContext2D = dom.window.CanvasRenderingContext2D;
global.Image = dom.window.Image;
global.Audio = dom.window.Audio || function() { return { play: () => {}, pause: () => {} }; };
global.AudioContext = dom.window.AudioContext || function() { return { createOscillator: () => ({ connect: () => {}, start: () => {}, stop: () => {} }), createGain: () => ({ connect: () => {}, gain: { value: 0 } }), destination: {} }; };

// Add requestAnimationFrame for Node.js compatibility
global.requestAnimationFrame = global.requestAnimationFrame || function(callback) {
    return setTimeout(callback, 16); // ~60fps
};
global.cancelAnimationFrame = global.cancelAnimationFrame || function(id) {
    clearTimeout(id);
};

// Mock Canvas context for testing (we don't need actual rendering)
const mockCanvasContext = {
    fillRect: () => {},
    strokeRect: () => {},
    clearRect: () => {},
    fill: () => {},
    stroke: () => {},
    beginPath: () => {},
    closePath: () => {},
    moveTo: () => {},
    lineTo: () => {},
    arc: () => {},
    save: () => {},
    restore: () => {},
    translate: () => {},
    rotate: () => {},
    scale: () => {},
    fillText: () => {},
    strokeText: () => {},
    measureText: () => ({ width: 100 }),
    createLinearGradient: () => ({ addColorStop: () => {} }),
    createRadialGradient: () => ({ addColorStop: () => {} }),
    getImageData: () => ({ data: new Uint8ClampedArray(4) }),
    putImageData: () => {},
    drawImage: () => {},
    globalAlpha: 1,
    globalCompositeOperation: 'source-over',
    fillStyle: '#000000',
    strokeStyle: '#000000',
    lineWidth: 1,
    lineCap: 'butt',
    lineJoin: 'miter',
    miterLimit: 10,
    shadowBlur: 0,
    shadowColor: 'rgba(0, 0, 0, 0)',
    shadowOffsetX: 0,
    shadowOffsetY: 0,
    font: '10px sans-serif',
    textAlign: 'start',
    textBaseline: 'alphabetic'
};

// Override HTMLCanvasElement.prototype.getContext to return our mock
if (global.HTMLCanvasElement) {
    global.HTMLCanvasElement.prototype.getContext = function(contextType) {
        if (contextType === '2d') {
            return mockCanvasContext;
        }
        return null;
    };
}

// Read the HTML file
const htmlFile = path.join(__dirname, '..', 'src', 'asteroids.html');
const htmlContent = fs.readFileSync(htmlFile, 'utf8');

// Extract JavaScript code between <script> tags (excluding CDN script)
const scriptMatches = htmlContent.match(/<script>[\s\S]*?<\/script>/g);
if (!scriptMatches) {
    console.error('No JavaScript code found in HTML file');
    process.exit(1);
}

// Get the main script (should be the last and largest one)
const mainScript = scriptMatches[scriptMatches.length - 1];
const jsCode = mainScript.replace(/<\/?script>/g, '');

// Set up global Math object for Node.js compatibility
global.Math = Math;

// Override requestAnimationFrame to prevent game loop from running
global.requestAnimationFrame = function(callback) {
    // Don't actually call the callback - this prevents the game loop
    return 1;
};

// Execute the JavaScript code - the browser code will handle all test framework setup
try {
    console.log('Running Asteroids Game Tests in Node.js\n');
    
    eval(jsCode);
    
    // Get test results from the browser code
    const results = global.getTestResults ? global.getTestResults() : { total: 0, failures: 1 };
    
    // Show summary using results from browser code
    console.log(`\n--- Test Summary ---`);
    console.log(`Total tests: ${results.total}`);
    console.log(`Passed: ${results.total - results.failures}`);
    console.log(`Failed: ${results.failures}`);
    
    if (results.failures > 0) {
        console.log('\nSome tests failed!');
        process.exit(results.failures > 255 ? 255 : results.failures); // Cap at 255 for shell exit codes
    } else {
        console.log('\nAll tests passed!');
        process.exit(0);
    }
    
} catch (error) {
    console.error('Error running tests:', error.message);
    console.error('Stack trace:', error.stack);
    process.exit(1);
}
